{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Install dependencies",
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm ci",
			"runOptions": { "runOn": "worktreeCreated" }
		},
		{
			"label": "Compile & Launch Extension Host",
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm run compile && COPILOT_LOG_TELEMETRY=true VSCODE_DEV_DEBUG=1 code --extensionDevelopmentPath=$(pwd)"
		},
		{
			"label": "Typecheck",
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm run typecheck"
		},
		{
			"label": "compile",
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm run compile",
			"problemMatcher": [],
		},
		{
			"type": "npm",
			"script": "watch",
			"label": "npm: watch - DO NOT USE", // The auto-discovered npm task is also called watch, so we change its name here. This is here until people clear their histories.
		},
		{
			"label": "ensure-deps",
			"type": "shell",
			"windows": {
				"command": "if not exist node_modules npm ci",
				"options": {
					"shell": {
						"executable": "cmd.exe",
						"args": ["/c"]
					}
				}
			},
			"linux": {
				"command": "test -d node_modules || (export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm ci)"
			},
			"osx": {
				"command": "test -d node_modules || (export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm ci)"
			},
			"group": "build",
			"presentation": {
				"reveal": "never",
				"close": true
			},
			"problemMatcher": [],
			"isBackground": true,
			"promptOnClose": false
		},
		{
			"label": "start-watch-tasks",
			"dependsOn": [
				"npm: watch:tsc-extension",
				"npm: watch:tsc-extension-web",
				"npm: watch:tsc-simulation-workbench",
				"npm: watch:esbuild"
			],
			"dependsOrder": "parallel",
			"group": "build",
			"presentation": {
				"reveal": "never"
			}
		},
		{
			"label": "watch",
			"dependsOn": [
				"ensure-deps",
				"start-watch-tasks",
			],
			"dependsOrder": "sequence",
			"presentation": {
				"reveal": "never",
			},
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && ./node_modules/.bin/tsc --noEmit --watch --project tsconfig.json",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"label": "npm: watch:tsc-extension",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && ./node_modules/.bin/tsc --noEmit --watch --project tsconfig.worker.json",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"label": "npm: watch:tsc-extension-web",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && ./node_modules/.bin/tsc --noEmit --watch --project test/simulation/workbench/tsconfig.json",
			"group": "build",
			"problemMatcher": "$tsc-watch",
			"isBackground": true,
			"label": "npm: watch:tsc-simulation-workbench",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"type": "shell",
			"command": "export NVM_DIR=\"$HOME/.nvm\" && [ -s \"$NVM_DIR/nvm.sh\" ] && . \"$NVM_DIR/nvm.sh\" && nvm use >/dev/null && npm run watch:esbuild",
			"group": "build",
			"problemMatcher": {
				"owner": "esbuild",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^\\[watch\\] build started$",
					"endsPattern": "^\\[watch\\] build finished$"
				}
			},
			"isBackground": true,
			"label": "npm: watch:esbuild",
			"presentation": {
				"group": "watch",
				"reveal": "never"
			}
		},
		{
			"label": "simulate",
			"type": "process",
			"command": "${workspaceFolder}/script/simulate.sh",
			"windows": {
				"command": "powershell",
				"args": ["-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/script/simulate.ps1"]
			},
			"args": [],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"presentation": {
				"reveal": "always",
				"panel": "dedicated",
				"clear": true,
				"focus": true
			},
			"problemMatcher": []
		}
	]
}